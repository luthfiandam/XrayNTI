{
  "name": "react-example",
  "private": true,
  "version": "0.6.7",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "auth:supabase:provision": "tsx scripts/provisionSupabaseUsers.ts",
    "auth:flow:test": "tsx scripts/testAuthFlow.ts",
    "cutover:test": "tsx scripts/testCorrectiveCutover.ts",
    "cache:test": "tsx src/services/cacheTest.ts",
    "timeline:test": "tsx scripts/testEquipmentTimeline.ts",
    "pdf:test": "tsx scripts/testPdfGeneration.ts",
    "excel:test": "tsx scripts/testExcelGeneration.ts",
    "doctor": "tsx scripts/doctor.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-pdf/renderer": "^4.6.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
